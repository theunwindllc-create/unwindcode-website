# Explicit production upstream configuration.
# /api/chat requires SUPABASE_URL and SUPABASE_ANON_KEY in production.
# /api/subscribe requires SUPABASE_URL plus either SUPABASE_SERVICE_ROLE_KEY
# or SUPABASE_ANON_KEY in production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-vercel-secret
SUBSCRIBERS_TABLE=website_subscribers
SUBSCRIBE_ALLOWED_ORIGINS=https://unwindcode.ai,https://www.unwindcode.ai
SUBSCRIBE_LOG_EVENTS=false
SUBSCRIBE_RATE_LIMIT_MAX=10
SUBSCRIBE_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_ALLOWED_ORIGINS=https://unwindcode.ai,https://www.unwindcode.ai
CHAT_LOG_EVENTS=false
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
ASSETS_RATE_LIMIT_MAX=60
ASSETS_RATE_LIMIT_WINDOW_SECONDS=60
CLAIMS_RATE_LIMIT_MAX=60
CLAIMS_RATE_LIMIT_WINDOW_SECONDS=60
ORGANISMS_RATE_LIMIT_MAX=60
ORGANISMS_RATE_LIMIT_WINDOW_SECONDS=60
TRANSMISSIONS_RATE_LIMIT_MAX=60
TRANSMISSIONS_RATE_LIMIT_WINDOW_SECONDS=60
SEARCH_RATE_LIMIT_MAX=60
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
GROUNDING_RATE_LIMIT_MAX=30
GROUNDING_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Edge Function fallback for /api/subscribe and required chat key for /api/chat.
SUPABASE_ANON_KEY=replace-with-public-anon-key

# Durable abuse-control check used by /api/subscribe, /api/chat, /api/assets,
# /api/claims, /api/organisms, /api/transmissions, /api/search, and
# /api/grounding.
# Required when VERCEL_ENV=production; missing/unavailable checks fail closed.
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
RATE_LIMIT_SALT=
# Default false: ignore forwarded client IP headers for limiter identity.
# Set true only after verifying the deployment proxy overwrites or strips
# client-supplied cf-connecting-ip, x-real-ip, and x-forwarded-for headers.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
